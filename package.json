{
  "name": "hibi-study-replica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "node scripts/start-desktop.mjs",
    "desktop:production": "npm run build && HIBI_PRODUCTION=1 electron electron/main.cjs",
    "build": "tsc --noEmit && vite build",
    "check:companion-assets": "node scripts/check-companion-assets.mjs",
    "safety:renderer": "node scripts/renderer-safety-check.mjs",
    "parity:check": "node scripts/parity-check.mjs",
    "audit": "npm run parity:check && npm run build && npm test && npm run test:e2e",
    "test": "vitest run src --exclude 'src/**/._*' && node --test electron/notifications.test.cjs",
    "test:e2e": "playwright test"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": { "@playwright/test": "latest", "@types/react": "latest", "@types/react-dom": "latest", "@vitejs/plugin-react": "latest", "electron": "latest", "typescript": "latest", "vite": "latest", "vitest": "latest" }
}

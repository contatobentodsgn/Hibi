{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "jsx": "react-jsx",
    "skipLibCheck": true, "noEmit": true, "allowJs": false,
    "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["src", "electron", "vite.config.ts"]
}
